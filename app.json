{
  "expo": {
    "name": "optimal-slepp-ny",
    "slug": "optimal-slepp-ny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "optimalsleppny",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Optimal Slepp leser pulsmålinger fra Apple Watch for mer presis søvnfase-deteksjon.",
        "NSHealthUpdateUsageDescription": "Optimal Slepp skriver søvnanalyse til Apple Health etter fullført nattopptak.",
        "NSMotionUsageDescription": "Optimal Slepp bruker akselerometeret for å registrere bevegelse under søvn."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "bundleIdentifier": "com.andrenormann.optimalslepp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BODY_SENSORS",
        "android.permission.health.READ_HEART_RATE"
      ],
      "package": "com.andrenormann.optimalslepp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-health",
        {
          "healthSharePermission": "Optimal Slepp leser pulsmålinger fra Apple Watch for mer presis søvnfase-deteksjon.",
          "healthUpdatePermission": "Optimal Slepp skriver søvnanalyse til Apple Health etter fullført nattopptak."
        }
      ],
      "./plugins/sleep-health-writer",
      "./plugins/strip-aps-entitlement",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
